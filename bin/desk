#!/usr/bin/env node
// desk — the only way a SigmaDesk seat talks to the desk. Speaks HTTP over the unix socket
// the sandbox allowlists (DESK_SOCKET), authenticated by this run's token (DESK_RUN_TOKEN).
import http from 'node:http';
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { spawn, spawnSync, execFileSync } from 'node:child_process';

const USAGE = `usage:
  desk show [KEY] | desk list [status]
  desk progress <0-100> "<msg>"
  desk comment [--key KEY] "<text>"            (or text on stdin)
  desk needs-human "<question>"
  desk propose --title T [--area A] [--priority P] [--type T]   (body on stdin; research runs only)
  desk revise KEY [--title T]   (revised proposal body on stdin; the author's research revision run only)
  desk connector-propose --name N   (connector case on stdin; thinking seats; owner approval required)
  desk groom KEY --complexity S|M|L|XL --area A [--priority P] [--risk high] [--assign SEAT] [--title T]   (spec on stdin)
  desk create-task --parent KEY --title T --complexity C --area A [--assign SEAT] [--after KEY|none] [--owner "<why only the owner can do it>"]   (body on stdin)
  desk lesson "<one sentence the team should remember>"   (builders, while fixing their own work; the owner approves it)
  desk split KEY "<summary>"   (manager, after create-task: the parent stays open until its tasks are done)
  desk design   (design doc on stdin; principals)
  desk discussion-result   (response on stdin; manager in an owner discussion)
  desk delegate "<summary>"   (principals, after creating slices with create-task [--after SLICE])
  desk reject KEY "<reason>"
  desk consult principal-be|principal-fe|dba "<question>"
  desk peer-review [--reviewer MODEL] [--challenger MODEL] "<design question>"  (manager/principals; once per run)
  desk council-models              approved review models, readiness and lenses
  desk council [--profile LENS] [--reviewer MODEL] [--challenger MODEL] "<question>"  (manager/principals; once per run)
  desk route KEY pm|manager|human "<why>" [--type T] [--priority P]
  desk submit [--verify-prod "<how to verify in production after the deploy>"] "<summary>"
  desk continue-rebase                     (implementer: after editing desk-listed conflict files)
  desk qa pass|fail "<notes>"
  desk accept pass|changes "<notes>"
  desk review approve --code N --checked "<what you checked>" [--risks "<risks>"] "<summary>"
  desk review changes --code N --findings '<JSON array>'|@file.json "<summary>"
  desk respond fixed|pushback --finding ID "<what you changed | why not>"
  desk respond done "<summary for the reviewers>"
  desk resolve done "<how you combined both sides>" | desk resolve stuck "<why the owner must decide>"
  desk context-file <path> [--page N]   (Perplexity seats: a desk-built file/diff block to send verbatim on the same thread)
  desk incident file --title T --severity P0-P3 --area A   (analysis on stdin)
  desk incident mute "<why it is noise>" | desk incident page "<why the owner must act>"
  desk pkg request name==version [...] --why "<what needs it>" [--dev]   (build runs: the desk resolves every wheel; the owner approves)
  desk pkg status | desk pkg install   (install: offline, into this workspace's .venv, from the approved wheels)
  desk test pytest|unittest [args…]   (runs the tests with the canonical interpreter — this workspace's .venv if any — and records the exit status and what ran; QA uses it)
  desk fetch <https-url>   (the desk fetches one page from its allowed documentation hosts; the text is untrusted)
  desk ops list | desk ops <probe> [--param value]   (seats holding a production read access grant)
  desk ops request <probe…|all> --why "<what you must check>" [--for 1h | --ticket]
  desk access list | desk access approve <id> [--for 1h | --ticket] "<why>" | desk access deny|owner <id> "<why>" | desk access revoke <id> "<why>"   (EM/SRE)
  desk verify done "<what production shows>" | desk verify owner "<why no read-only probe can answer>"   (SRE verify runs)
  desk watch verified|regression|inconclusive "<what production shows>"   (SRE post-deploy check runs)
  desk reply "<answer>"   (a run where the owner tagged you: your one answer in the thread)
  desk handoff implement|design|verify "<what>" | desk handoff task --title T "<what>" | desk handoff merge|deploy "<what was asked>"   (tagged runs: route real work into the normal jobs)`;

const [cmd, ...rest] = process.argv.slice(2);
// Help must exit before parsing flags, reading stdin or sending a mutating request.
// desk test passes its arguments through untouched (pytest has its own -h): only `desk test` alone or `desk test -h` is help.
const wantsHelp = cmd === 'test' ? !rest.length || ['-h', '--help'].includes(rest[0]) : [cmd, ...rest].some((arg) => arg === '-h' || arg === '--help');
if (!cmd || wantsHelp) {
  console.log(USAGE); process.exit(cmd ? 0 : 2);
}

const flags = {};
const pos = [];
for (let i = 0; i < rest.length; i++) {
  // A flag with no value (`--owner --after X`, or last) is true, never the next flag's name.
  if (rest[i].startsWith('--')) { const v = rest[i + 1]; if (v === undefined || v.startsWith('--')) flags[rest[i].slice(2)] = true; else { flags[rest[i].slice(2)] = v; i++; } } else pos.push(rest[i]);
}
const KEY_RE = /^[A-Z][A-Z0-9]*-\d+$/;

// Read piped text (heredocs), but never hang on an open-but-silent stdin.
function stdinText() {
  if (process.stdin.isTTY) return Promise.resolve('');
  return new Promise((resolve) => {
    let s = '';
    const done = () => { process.stdin.pause(); resolve(s.trim()); };
    const idle = setTimeout(done, 1500);
    process.stdin.on('data', (c) => { s += c; idle.refresh(); });
    process.stdin.on('end', () => { clearTimeout(idle); done(); });
    process.stdin.on('error', () => { clearTimeout(idle); done(); });
  });
}

const body = { ...flags };
const takeKey = () => { if (pos[0] && KEY_RE.test(pos[0])) body.key = pos.shift(); };
switch (cmd) {
  case 'show': takeKey(); break;
  case 'list': body.status = pos[0]; break;
  case 'progress': body.pct = Number(pos[0]); body.msg = pos.slice(1).join(' '); break;
  case 'route': takeKey(); body.to = pos.shift(); body.body = pos.join(' '); break;
  case 'consult': body.agent = pos.shift(); body.body = pos.join(' '); break;
  case 'qa': case 'accept': case 'review': body.verdict = pos.shift(); body.body = pos.join(' '); break;
  case 'pkg': body.action = pos.shift() || 'status'; if (body.action === 'request') body.specs = pos.splice(0); break;
  case 'fetch': body.url = pos.shift(); break;
  case 'test': for (const k of Object.keys(body)) delete body[k]; body.action = 'plan'; body.args = rest.slice(); break;
  case 'ops': body.probe = pos.shift() || 'list'; if (body.probe === 'request') body.probes = pos.splice(0); break;
  case 'access': body.action = pos.shift() || 'list'; if (/^\d+$/.test(pos[0] || '')) body.id = pos.shift(); body.body = pos.join(' '); break;
  case 'respond': case 'resolve': case 'verify': case 'watch': case 'handoff': body.action = pos.shift(); body.body = pos.join(' '); break;
  case 'incident': body.action = pos.shift(); body.body = pos.join(' '); break;
  case 'context-file': body.path = pos.join(' '); break;
  case 'lesson': body.body = pos.join(' '); break;
  case 'groom': case 'reject': case 'split': case 'comment': case 'needs-human': case 'revise': takeKey(); body.body = pos.join(' '); break;
  default: body.body = pos.join(' ');
}
// --findings @file.json: read the findings from a file the reviewer wrote (JSON is awkward to quote on a command line).
if (typeof body.findings === 'string' && body.findings.startsWith('@')) {
  try { body.findings = fs.readFileSync(path.resolve(body.findings.slice(1)), 'utf8'); } catch (e) { console.error(`desk: cannot read ${body.findings.slice(1)} (${e.message})`); process.exit(2); }
}
if (!body.body && !['show', 'list', 'progress', 'continue-rebase', 'context-file', 'ops', 'access', 'pkg', 'fetch', 'test'].includes(cmd)) body.body = await stdinText();
else if (['groom', 'propose', 'create-task', 'incident', 'design', 'revise', 'connector-propose'].includes(cmd) && !body.body) body.body = await stdinText();

const token = process.env.DESK_RUN_TOKEN;
const mailbox = process.env.DESK_MAILBOX;
const socketPath = process.env.DESK_SOCKET;
if (!token || (!mailbox && !socketPath)) { console.error('desk: not inside a SigmaDesk run (DESK_RUN_TOKEN and DESK_SOCKET/DESK_MAILBOX unset)'); process.exit(2); }

function finish(status, j) {
  if (status >= 400 || j.error) { console.error(`desk ${cmd}: ${j.error || status}`); process.exit(1); }
  console.log(j.output ?? 'ok');
  process.exit(0);
}

/** One request to the desk over this run's transport → { status, j }. */
function send(command, payloadBody) {
  return new Promise((resolve) => {
    if (mailbox) {
      // File transport: drop a request into the mailbox, wait for the desk's reply file.
      const id = crypto.randomBytes(8).toString('hex');
      const tmp = path.join(mailbox, `.req-${id}.tmp`);
      fs.writeFileSync(tmp, JSON.stringify({ token, cmd: command, body: payloadBody }));
      fs.renameSync(tmp, path.join(mailbox, `req-${id}.json`));
      const res = path.join(mailbox, `res-${id}.json`);
      const deadline = Date.now() + 15 * 60_000;
      const wait = () => {
        if (fs.existsSync(res)) {
          const j = JSON.parse(fs.readFileSync(res, 'utf8'));
          fs.unlinkSync(res);
          return resolve({ status: j.error ? 400 : 200, j });
        }
        if (Date.now() > deadline) { console.error('desk: timed out waiting for the desk'); process.exit(1); }
        setTimeout(wait, 250);
      };
      wait();
      return;
    }
    const payload = JSON.stringify(payloadBody);
    const req = http.request({ socketPath, path: `/desk/${command}`, method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload), Authorization: `Bearer ${token}` },
      timeout: 15 * 60_000 }, (res) => {
      let data = '';
      res.on('data', (c) => { data += c; });
      res.on('end', () => {
        let j;
        try { j = JSON.parse(data); } catch { j = { error: data }; }
        resolve({ status: res.statusCode, j });
      });
    });
    req.on('error', (e) => { console.error(`desk: cannot reach the desk (${e.message})`); process.exit(1); });
    req.on('timeout', () => { req.destroy(new Error('timeout')); });
    req.end(payload);
  });
}

/**
 * desk pkg install: the desk hands over the exact offline steps (after checking the grant); they run HERE, inside this
 * run's sandbox (no network; the approved wheels are readable, nothing else new). Each step prints what it does.
 * Then the desk reads the venv back and records its fingerprint.
 */
function runSteps(plan) {
  const base = scrubbed();
  for (const st of plan.steps) {
    if (st.unless && fs.existsSync(st.unless)) { console.log(`- ${st.label}: already there`); continue; }
    console.log(`- ${st.label}`);
    try {
      if (st.remove) { for (const f of st.remove) { try { if (!fs.lstatSync(f).isDirectory()) fs.rmSync(f); } catch { /* not there */ } } continue; }
      if (st.write) { fs.mkdirSync(path.dirname(st.write.path), { recursive: true }); fs.writeFileSync(st.write.path, st.write.text); continue; }
      if (st.exclude) {
        const p = execFileSync('git', ['-C', st.exclude.ws, 'rev-parse', '--git-path', 'info/exclude'], { encoding: 'utf8' }).trim();
        const file = path.resolve(st.exclude.ws, p);
        const have = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '';
        if (!have.split('\n').includes(st.exclude.line)) { fs.mkdirSync(path.dirname(file), { recursive: true }); fs.appendFileSync(file, `${have && !have.endsWith('\n') ? '\n' : ''}${st.exclude.line}\n`); }
        continue;
      }
      console.log(`  $ ${st.argv.map((a) => (/^[\w@%+=:,./-]+$/.test(a) ? a : `'${a.split("'").join(`'\\''`)}'`)).join(' ').slice(0, 600)}`);
      const r = spawnSync(st.argv[0], st.argv.slice(1), { env: { ...base, ...(st.env || {}) }, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
      const out = `${r.stdout || ''}${r.stderr || ''}`;
      if (out.trim()) console.log(out.trim().split('\n').slice(-40).map((l) => `  ${l}`).join('\n'));
      if (r.status !== 0) return { ok: false, step: st.label, output: (r.error ? r.error.message : out).slice(-2000) };
    } catch (e) {
      return { ok: false, step: st.label, output: String(e.message).slice(-2000) };
    }
  }
  return { ok: true };
}

const scrubbed = (also = []) => Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^(PIP_|PYTHON|PYTEST_|VIRTUAL_ENV$|CONDA)/.test(k) && !also.includes(k)));
const first = await send(cmd, body);
if (cmd === 'test' && first.status < 400 && !first.j.error && first.j.output?.test) {
  // Run the desk's canonical interpreter here, in this run's sandbox and workspace; the exit status goes back as-is.
  const t = first.j.output.test;
  console.log(`$ ${t.argv.join(' ').slice(0, 400)}`);
  // Streamed through (and its tail kept: unittest reports what ran only in its output).
  let tail = '';
  const keep = (c) => { tail = (tail + c).slice(-65_536); };
  const status = await new Promise((resolve) => {
    const child = spawn(t.argv[0], t.argv.slice(1), { cwd: t.cwd, env: { ...scrubbed(t.scrub || []), ...(t.env || {}) }, stdio: ['inherit', 'pipe', 'pipe'] });
    child.stdout.on('data', (c) => { process.stdout.write(c); keep(c); });
    child.stderr.on('data', (c) => { process.stderr.write(c); keep(c); });
    child.on('error', (e) => { console.error(`desk test: ${e.message}`); resolve(-1); });
    child.on('close', (code) => resolve(code ?? -1));
  });
  const done = await send('test', { action: 'result', id: t.id, status, output: tail });
  if (done.status >= 400 || done.j.error) { console.error(`desk test: ${done.j.error || done.status}`); process.exit(1); }
  console.log(done.j.output);
  process.exit(status === 0 && !/NOT counted/.test(String(done.j.output)) ? 0 : status > 0 ? status : 1);
}
if (cmd === 'pkg' && body.action === 'install' && first.status < 400 && !first.j.error && first.j.output?.plan) {
  const plan = first.j.output.plan;
  if (plan.skipped?.length) console.log(`(request ${plan.skipped.map((x) => `#${x}`).join(', ')} was approved after this run started: not readable here)`);
  const result = runSteps(plan);
  const done = await send('pkg', { action: 'installed', ...result });
  if (!result.ok) { console.error(`desk pkg install: failed at "${result.step}"`); if (done.j.output) console.error(done.j.output); process.exit(1); }
  finish(done.status, done.j);
} else finish(first.status, first.j);
