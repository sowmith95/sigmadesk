{
  "server": {
    "port": 8790,
    "hosts": [
      "127.0.0.1"
    ],
    "ownerToken": "",
    "preventIdleSleep": true
  },
  "project": {
    "name": "my-app",
    "repoPath": "~/code/my-app",
    "githubRepo": "",
    "baseBranch": "main",
    "branchPrefix": "sigmadesk/",
    "ticketPrefix": "SD",
    "playbook": "playbooks/default.md",
    "copyPaths": [
      "web/node_modules"
    ],
    "env": {
      "TZ": "America/New_York"
    },
    "extraAllowedBash": [],
    "readOnlyPaths": []
  },
  "limits": {
    "maxConcurrent": 2,
    "busyWindow": {
      "enabled": false,
      "timezone": "America/New_York",
      "days": [
        1,
        2,
        3,
        4,
        5
      ],
      "start": "09:30",
      "end": "16:15",
      "maxConcurrent": 1
    },
    "dailyBudgetUsd": 50,
    "runBudgetUsd": {
      "fable": 8,
      "opus": 5,
      "sonnet": 3,
      "haiku": 0.75
    }
  },
  "delegation": {
    "kinds": {
      "owner_task": "shadow",
      "question": "shadow",
      "research": "shadow",
      "loop_limit": "shadow",
      "design": "shadow"
    },
    "peerAccess": false
  },
  "github": {
    "sync": true,
    "openDraftPrs": true,
    "label": "sigmadesk",
    "trustedAuthors": []
  },
  "pm": {
    "enabled": true,
    "intervalMinutes": 360,
    "persona": "a quant trader and 0-5 DTE options scalper who uses this product every day",
    "competitors": [
      "Unusual Whales",
      "SpotGamma",
      "OptionStrat",
      "TradingView"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowedDomains": []
  },
  "team": {
    "junior": {
      "model": "sonnet"
    },
    "pm": {
      "name": "Avery"
    }
  },
  "notify": {
    "webhookUrl": "",
    "boardUrl": "http://my-mac:8790",
    "events": [
      "needs_human",
      "ready_for_human",
      "page"
    ]
  },
  "engines": {
    "autoFallback": true,
    "fallbackCooldownMinutes": 15,
    "codex": {
      "bin": "",
      "runBudgetUsd": 3,
      "models": []
    },
    "perplexity": {
      "contextMaxChars": 60000,
      "relayReserveChars": 8000,
      "remoteWaitMinutes": 8,
      "followupRounds": 1,
      "prepareDeadlineSeconds": 45,
      "pageChars": 0,
      "pageRounds": 6,
      "maxRunMinutes": 90,
      "secretPatterns": [],
      "models": [],
      "councilEnabled": false
    }
  },
  "research": {
    "marketHours": { "timezone": "America/New_York", "days": [1, 2, 3, 4, 5], "start": "09:30", "end": "16:00" },
    "connectors": {},
    "programs": [],
    "review": { "minReviewers": 1, "reviewers": ["trading-advisor", "quant-research", "principal-be"] }
  },
  "advisors": {
    "keyFile": "~/projects/sigmadesk/local/advisor-keys.json",
    "reserveUsd": 1,
    "timeoutSeconds": 120,
    "maxOutputTokens": 3000
  }
}
