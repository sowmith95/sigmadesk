{
  "name": "sigmadesk",
  "version": "0.1.0",
  "description": "An AI engineering desk run like a quant firm: real Claude Code agents per seat, a live Jira-style board, sandboxed execution, GitHub sync, and an on-call SRE that turns production errors into fixes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sigmadesk": "src/server.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "doctor": "node --disable-warning=ExperimentalWarning src/doctor.js",
    "models:refresh": "node --disable-warning=ExperimentalWarning scripts/refresh-perplexity-models.mjs",
    "preview": "node --disable-warning=ExperimentalWarning scripts/local-preview.mjs",
    "build:ui": "vite build --config vite.config.js && node scripts/ui-stamp.mjs",
    "dev:ui": "vite --config vite.config.js",
    "check:ui": "node scripts/ui-stamp.mjs --check",
    "typecheck": "tsc --noEmit",
    "ui:shots": "node --disable-warning=ExperimentalWarning scripts/ui-shots.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "multi-agent",
    "kanban",
    "jira",
    "devops",
    "sre",
    "github"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.52.0",
    "playwright-core": "1.63.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
